---
import Base from '../layouts/Base.astro';
---

<Base title="Submit an entry · Token Cost Index">
  <section class="max-w-2xl">
    <h1 class="text-figure m-0 text-3xl font-semibold tracking-tight">
      Submit an entry
    </h1>
    <p class="mt-3 text-base leading-relaxed">
      Share measured token counts for a defined business task. You will need a
      task and unit, token counts from at least 10 task units, and a note on how
      you measured. Entries are reviewed before they appear.
    </p>
    <p class="mt-4 text-sm">
      The submission form arrives with Phase 3, once sign-in is wired up.
    </p>
  </section>
</Base>
