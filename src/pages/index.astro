---
import Base from '../layouts/Base.astro';
---

<Base title="Token Cost Index">
  <section class="max-w-2xl">
    <h1 class="text-figure m-0 text-3xl font-semibold tracking-tight">
      What does AI cost per task?
    </h1>
    <p class="mt-3 text-base leading-relaxed">
      An open dataset of measured token costs for business AI tasks. Each entry
      records how many tokens a defined task consumed, measured from real usage.
      Costs are stored as tokens and priced to dollars at current model rates.
    </p>
  </section>

  <section class="mt-8 border border-rule">
    <div class="border-b border-rule px-4 py-3">
      <h2 class="m-0 text-sm font-semibold tracking-tight">Approved entries</h2>
    </div>
    <div class="px-4 py-12 text-center">
      <p class="m-0 text-sm">
        No entries yet. The index opens once seed data is approved.
      </p>
      <p class="mt-2 text-sm">
        <a href="/submit">Submit the first one</a>.
      </p>
    </div>
  </section>

  <p class="mt-4 text-xs">
    The searchable table, filters, and repricing calculator arrive with Phase 4.
  </p>
</Base>
