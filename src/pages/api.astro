---
import Base from '../layouts/Base.astro';
---

<Base title="API · Token Cost Index">
  <section class="max-w-2xl">
    <h1 class="text-figure m-0 text-3xl font-semibold tracking-tight">
      API
    </h1>
    <p class="mt-3 text-base leading-relaxed">
      The full approved dataset is readable over a public endpoint and as
      versioned JSON exports. No key needed for reads.
    </p>
    <p class="mt-4 text-sm">
      Endpoint documentation with copy-paste examples arrives with Phase 5.
    </p>
  </section>
</Base>
