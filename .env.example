# Copy to .env for local dev and set the same values in Cloudflare Pages.
# Both values are safe in the browser: the anon key is public by design and RLS
# does the security work. Never put the service role key here or anywhere in the
# site. It stays in Supabase Studio and the export Action secret only.

PUBLIC_SUPABASE_URL=https://ggpucjklyigxmnhdtyuj.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
